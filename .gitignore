# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which might contain sensitive data or account info
*.tfvars
!example.tfvars

# Ignore override files as they are usually used only locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include fake override files for testing
!example_override.tf

# Ignore CLI configuration files
.terraformrc
terraform.rc
